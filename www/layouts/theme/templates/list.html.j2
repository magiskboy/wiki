{% extends "base.html.j2" %}
{% block main %}
<div class="post-list">
  {% for item in page.get('items', []) %}
    {% include "partials/postitem.html.j2" %}
    {% if not loop.last %}<hr>{% endif %}
  {% endfor %}
  {% set p = page.get('pagination') %}
  {% if p and p.total > 1 %}
    <nav class="pagination">
      {% if p.prev %}<a href="{{ p.prev }}">« Trước</a>{% endif %}
      <span>{{ p.current }} / {{ p.total }}</span>
      {% if p.next %}<a href="{{ p.next }}">Tiếp »</a>{% endif %}
    </nav>
  {% endif %}
</div>
{% endblock %}
