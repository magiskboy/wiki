{% set plang = page.get('lang') or default_locale or 'vi' %}
{% set home = '/' if plang == (default_locale or 'vi') else '/' + plang + '/' %}
<div class="nav">
  <div class="nav-top">
    <div class="left">
      {% if page.get('translations') and page.translations | length > 1 %}
        <span class="lang-switcher">
          {% for t in page.translations %}
            {% if not loop.first %}<span class="sep">|</span>{% endif %}
            {% if t.active %}<span class="lang active">{{ t.lang | upper }}</span>
            {% else %}<a class="lang" href="{{ t.url }}" hreflang="{{ t.lang }}">{{ t.lang | upper }}</a>{% endif %}
          {% endfor %}
        </span>
      {% elif translations %}
        <span class="lang-switcher">
          <span class="lang active">{{ plang | upper }}</span>
          {% for t in translations %}
            <span class="sep">|</span>
            <a class="lang" href="{{ t.url }}" hreflang="{{ t.lang }}">{{ t.lang | upper }}</a>
          {% endfor %}
        </span>
      {% endif %}
      <select class="theme-switcher" aria-label="Chế độ xem" onchange="setTheme(this.value)">
        <option value="light">Sáng</option>
        <option value="dark">Tối</option>
        <option value="papyrus">Papyrus</option>
      </select>
    </div>
    <div class="nav-social">
      {% for s in site.get('socials', []) %}<a href="{{ s.link }}" target="_blank" rel="noreferrer">{{ s.title }}</a>{% endfor %}
    </div>
  </div>
  <div class="nav-bottom">
    {% for item in site.get('navs', []) %}
      {% if item.link.startswith('http') %}
        <a href="{{ item.link }}" target="_blank" rel="noreferrer">{{ item.title }}</a>
      {% else %}
        <a href="{{ home }}{{ item.link.lstrip('/') }}">{{ item.title }}</a>
      {% endif %}
    {% endfor %}
  </div>
</div>
<script>
  function setTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('theme', t);
    var frame = document.querySelector('.utterances-frame');
    if (frame) {
      frame.contentWindow.postMessage(
        {type: 'set-theme', theme: t === 'light' ? 'github-light' : 'github-dark'},
        'https://utteranc.es'
      );
    }
  }
  (function () {
    var sel = document.querySelector('.theme-switcher');
    if (sel) sel.value = localStorage.getItem('theme') || 'light';
  })();
</script>
