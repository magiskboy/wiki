{% extends "base.html.j2" %}
{% block title %}Đồ thị tri thức · {{ site.title }}{% endblock %}
{% block main_class %} site-main--graph{% endblock %}
{% block main %}
<script id="graph-data" type="application/json">{{ page.graph_json | safe }}</script>
<div class="graph-stage">
  <div id="kb-graph" role="application" aria-label="Đồ thị tri thức"></div>
  <div id="kb-graph-3d" role="application" aria-label="Đồ thị tri thức (3D)" hidden></div>
  <div id="graph-legend" class="graph-legend" aria-label="Chú giải lĩnh vực"></div>
  <div class="graph-controls">
    <button type="button" id="graph-3d-toggle" class="graph-toggle" aria-pressed="false" title="Chuyển sang biểu diễn 3D">3D</button>
    <button type="button" id="graph-dir-toggle" class="graph-toggle" aria-pressed="false" title="Hiển thị hướng cạnh bằng animation">Hướng</button>
    <button type="button" id="graph-tfidf-toggle" class="graph-toggle" aria-pressed="false" title="Edge weight theo TF-IDF tag chung">TF-IDF</button>
    <button type="button" id="graph-field-toggle" class="graph-toggle" aria-pressed="true">Trường màu</button>
  </div>
  <aside id="graph-panel" class="graph-panel" hidden></aside>
</div>
{% endblock %}
{% block scripts %}
<script>window.KB_ROOT="";</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.2/cytoscape.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/layout-base@2.0.1/layout-base.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cose-base@2.2.0/cose-base.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-fcose@2.2.0/cytoscape-fcose.js"></script>
<script src="/assets/graph.js" defer></script>
{% endblock %}
